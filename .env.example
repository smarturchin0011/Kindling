# 复制为 .env 并填入你自己的 key
# Kindling 会优先读项目根的 .env，找不到再回退到 Hermes 的 .env

# 必填：OpenRouter API key（https://openrouter.ai/keys）
OPENROUTER_API_KEY=sk-or-v1-你的key

# 可选：首次启动的默认模型。之后由应用内「设置」面板接管，
# 改模型不需要重启，也不需要动这个文件。
KINDLING_MODEL=anthropic/claude-sonnet-4.5

# 可选：服务地址
# KINDLING_HOST=127.0.0.1
# KINDLING_PORT=8777

# 可选：状态文件位置（默认 ~/.kindling/state.json）
# KINDLING_STATE=/path/to/state.json
